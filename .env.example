# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# This example file is committed, so it must contain only placeholders.

DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/polypodium

# Secret used to sign all JWTs. Minimum 32 chars, unique and random.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_random_chars

PHOTOS_DIR=./photos
PORT=8080

# CORS: '*' to allow any origin, or a comma-separated allowlist
# (e.g. https://app.example.com,https://admin.example.com).
ALLOWED_ORIGINS=*

# Application Environment (development or production)
APP_ENV=development

# SSL on the database connection (true/false)
# Set to false when db and server are on the same private network (e.g. Docker Compose)
DB_SSL=false

# --- TLS for incoming requests (production only) ---
# Option A: the server terminates HTTPS itself — provide both cert and key:
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
#
# Option B: TLS terminates at a reverse proxy (e.g. Nginx Proxy Manager) and
# the server serves plain HTTP behind it. Set this instead of the certs:
# BEHIND_PROXY=true
#
# In production the server refuses to start unless one of the two is configured.

# Optional: gate the very first (admin) self-registration behind a shared
# secret so nobody can grab admin by being first to hit a fresh server.
# REGISTRATION_TOKEN=some-long-random-value

# Optional: brute-force limits on /api/v1/auth/* (defaults shown)
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW=300
